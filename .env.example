# Caderneta — variáveis de ambiente (ADR 007, Item D5 da Pauta de Deliberação Gate 0)
# Levantadas por grep em core/, api/, infra/ — nenhum valor de exemplo é real.

# URL de conexão SQLAlchemy. Obrigatória para a API (api/dependencies.py) —
# a autenticação não inicia sem esta variável. No CLI (core/cli.py), a
# ausência faz o sistema cair para um SQLite local em ./caderneta.db.
DATABASE_URL=postgresql+psycopg://usuario:senha@localhost:5432/caderneta

# "dev" habilita /docs, /redoc, /openapi.json e cookies de sessão sem HTTPS,
# e permite CADERNETA_SECRET_KEY ausente (gera chave efêmera com aviso).
# Qualquer outro valor (ou ausência) é tratado como produção.
CADERNETA_ENV=dev

# Chave de assinatura do cookie de sessão (api/auth/session.py). Obrigatória
# fora de CADERNETA_ENV=dev — a Interface Web não inicia sem ela em produção.
CADERNETA_SECRET_KEY=

# Valor decimal — limite de lançamento elegível para aprovação simples
# (um só aprovador). Acima disso, exige o fluxo de dois aprovadores.
# Default no código se ausente: 5000.00
LIMITE_APROVACAO_SIMPLES=5000.00
